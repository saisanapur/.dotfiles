{
  "effortLevel": "medium",
  "enabledPlugins": {
    "sai-wip@sai-personal": true,
    "superpowers@superpowers-marketplace": true
  },
  "extraKnownMarketplaces": {
    "gsync-local": {
      "source": {
        "path": "/workspaces/obsidian/scripts/gsync/claude-plugin",
        "source": "directory"
      }
    },
    "sai-personal": {
      "source": {
        "path": "/home/vscode/dotfiles/claude-plugins",
        "source": "directory"
      }
    },
    "superpowers-marketplace": {
      "source": {
        "repo": "obra/superpowers-marketplace",
        "source": "github"
      }
    }
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "python3 /home/vscode/.dev/hooks/providers/claude/finish.py",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "idle_prompt"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "async": true,
            "command": "python3 /home/vscode/.dev/hooks/providers/claude/heartbeat.py",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "python3 /home/vscode/.dev/hooks/providers/claude/finish.py",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "command": "python3 /home/vscode/.dev/hooks/providers/claude/finish.py",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "python3 /home/vscode/.dev/hooks/providers/claude/start.py",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  },
  "permissions": {
    "additionalDirectories": [
      "/home/vscode/dotfiles",
      "/home/vscode/dotfiles/claude-plugins"
    ],
    "allow": [
      "mcp__mongodb__count",
      "Bash(just *)",
      "Bash(turbo *)",
      "Bash(npx eslint *)",
      "Bash(npx oxfmt *)",
      "Bash(prek *)",
      "Bash(docker compose:*)",
      "Bash(docker inspect *)",
      "Bash(docker rm *)",
      "Bash(docker network *)",
      "Bash(git push *)",
      "Bash(git worktree *)",
      "Bash(git branch *)",
      "Bash(git rebase *)",
      "Bash(gh pr *)",
      "Bash(netstat -tlnp)",
      "Bash(sudo lsof *)",
      "Bash(sudo ss *)",
      "Bash(sudo netstat *)",
      "Bash(sudo fuser *)",
      "Bash(sudo iptables *)",
      "Bash(git -C ~/dotfiles *)",
      "Bash(git -C ~/dotfiles add *)",
      "Bash(git -C ~/dotfiles commit *)",
      "Bash(git -C ~/dotfiles push *)",
      "Bash(git -C ~/dotfiles status)",
      "Bash(git -C ~/dotfiles diff *)",
      "Bash(git -C ~/dotfiles log *)",
      "Bash(bash ~/dotfiles/install.sh)",
      "Read(//home/vscode/**)",
      "Bash(NODE_OPTIONS=\"--max-old-space-size=8192\" npx eslint --fix packages/client-access/src/pages/access/reviews/shared/account-access-recommendation/signals.tsx)",
      "Bash(NODE_OPTIONS=\"--max-old-space-size=8192\" npx eslint --fix apps/web/src/access-management/graphql/resolvers/type-resolvers/AccessReviewAccountSnapshot.ts)",
      "Bash(NODE_OPTIONS=\"--max-old-space-size=8192\" npx eslint --fix packages/server-common/src/schemas/accessReviewAccountSnapshot.ts)",
      "Bash(NODE_OPTIONS=\"--max-old-space-size=8192\" npx eslint --fix packages/access-management/src/access-reviews/services/account-access-recommendations/rules/approved-access-request-rule.test.ts packages/access-management/src/access-reviews/services/account-access-recommendations/rules/denied-access-request-rule.test.ts packages/access-management/src/access-reviews/services/account-access-recommendations/rules/inactivity-rule.test.ts)"
    ]
  },
  "theme": "dark"
}
