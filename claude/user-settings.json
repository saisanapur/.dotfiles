      "/home/vscode/dotfiles/claude-plugins"
    ]
  },
  "model": "sonnet",
  "hooks": {
    "Notification": [
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/vscode/.dev/hooks/providers/claude/finish.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/vscode/.dev/hooks/providers/claude/heartbeat.py",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/vscode/.dev/hooks/providers/claude/finish.py",
            "timeout": 10
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/vscode/.dev/hooks/providers/claude/finish.py",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/vscode/.dev/hooks/providers/claude/start.py",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "sai-wip@sai-personal": true,
    "superpowers@superpowers-marketplace": true
  },
  "extraKnownMarketplaces": {
    "gsync-local": {
      "source": {
        "source": "directory",
        "path": "/workspaces/obsidian/scripts/gsync/claude-plugin"
      }
    },
    "sai-personal": {
      "source": {
        "source": "directory",
        "path": "/home/vscode/dotfiles/claude-plugins"
      }
    },
    "superpowers-marketplace": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers-marketplace"
      }
    }
  },
  "effortLevel": "medium",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "tui": "fullscreen",
  "cleanupPeriodDays": 14
}
